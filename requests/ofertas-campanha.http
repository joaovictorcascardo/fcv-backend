@api = http://localhost:3333/api/v1

###
# @name login
POST {{api}}/auth/login
Content-Type: application/json

{
  "email": "admin@fcv.org.br",
  "senha": "123456"
}

###
@token = {{login.response.body.$.token}}

###
GET {{api}}/ofertas-campanha
Authorization: Bearer {{token}}

###
GET {{api}}/ofertas-campanha/1
Authorization: Bearer {{token}}

###
# @name novaOfertaItem
POST {{api}}/ofertas-campanha
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "beneficio_campanha_id": 1,
  "conveniado_id": 1
}

###
PUT {{api}}/ofertas-campanha/{{novaOfertaItem.response.body.$.id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": "INATIVO"
}

###
DELETE {{api}}/ofertas-campanha/{{novaOfertaItem.response.body.$.id}}
Authorization: Bearer {{token}}

###
# 409: a oferta de campanha 1 tem utilizações registradas
DELETE {{api}}/ofertas-campanha/1
Authorization: Bearer {{token}}

###
# 400: oferta de campanha não aceita beneficio_id (use /ofertas)
POST {{api}}/ofertas-campanha
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "beneficio_campanha_id": 1,
  "conveniado_id": 1,
  "beneficio_id": 1
}

###
# 409: o conveniado 2 já oferece o item 1
POST {{api}}/ofertas-campanha
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "beneficio_campanha_id": 1,
  "conveniado_id": 2
}

###
# 409: a oferta de campanha 1 tem utilizações, não pode trocar de conveniado
PUT {{api}}/ofertas-campanha/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "conveniado_id": 1
}
