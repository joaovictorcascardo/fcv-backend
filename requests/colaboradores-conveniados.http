@api = http://localhost:3333/api/v1

###
# @name login
POST {{api}}/auth/login
Content-Type: application/json

{
  "email": "admin@fcv.org.br",
  "senha": "123456"
}

###
@token = {{login.response.body.$.token}}

# ========================================================
# 1. COLABORADORES (/colaboradores)
# ========================================================

### 1.1 Listar colaboradores
GET {{api}}/colaboradores
Authorization: Bearer {{token}}

### 1.2 Buscar colaborador por ID
GET {{api}}/colaboradores/1
Authorization: Bearer {{token}}

### 1.3 Buscar colaborador com ID inválido (Retorna 400)
GET {{api}}/colaboradores/invalido
Authorization: Bearer {{token}}

### 1.4 Criar usuário para vincular ao novo colaborador
# @name usuarioColab
POST {{api}}/usuarios
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome": "Helena Prado",
  "email": "helena.prado@fcv.org.br",
  "senha": "senhaSegura123",
  "perfil_id": 3
}

### 1.5 Criar colaborador com sucesso (Retorna 201)
# @name novoColaborador
POST {{api}}/colaboradores
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "usuario_id": {{usuarioColab.response.body.$.id}},
  "matricula": "FCV0999",
  "setor": "Farmácia hospitalar",
  "cargo": "Farmacêutica",
  "data_admissao": "2026-09-01",
  "telefone": "32988887777"
}

### 1.6 Criar colaborador com matrícula já cadastrada (Retorna 409)
POST {{api}}/colaboradores
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "usuario_id": 2,
  "matricula": "FCV0999",
  "setor": "Recepção",
  "cargo": "Atendente",
  "data_admissao": "2026-09-01"
}

### 1.7 Criar colaborador vinculando usuário que já possui cadastro (Retorna 409)
POST {{api}}/colaboradores
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "usuario_id": {{usuarioColab.response.body.$.id}},
  "matricula": "FCV0888",
  "setor": "TI",
  "cargo": "Analista",
  "data_admissao": "2026-09-01"
}

### 1.8 Atualizar dados do colaborador (Retorna 200)
PUT {{api}}/colaboradores/{{novoColaborador.response.body.$.id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": "AFASTADO"
}

### 1.9 Atualizar colaborador com payload vazio (Retorna 400)
PUT {{api}}/colaboradores/{{novoColaborador.response.body.$.id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{}

### 1.10 Tentativa de excluir colaborador com histórico de utilizações (Retorna 409)
DELETE {{api}}/colaboradores/1
Authorization: Bearer {{token}}

### 1.11 Excluir colaborador sem histórico de utilizações (Retorna 204)
DELETE {{api}}/colaboradores/{{novoColaborador.response.body.$.id}}
Authorization: Bearer {{token}}


# ========================================================
# 2. CONVENIADOS (/conveniados)
# ========================================================

### 2.1 Listar conveniados
GET {{api}}/conveniados
Authorization: Bearer {{token}}

### 2.2 Buscar conveniado por ID
GET {{api}}/conveniados/1
Authorization: Bearer {{token}}

### 2.3 Buscar conveniado com ID inexistente (Retorna 404)
GET {{api}}/conveniados/99999
Authorization: Bearer {{token}}

### 2.4 Criar usuário para vincular ao novo conveniado
# @name usuarioConv
POST {{api}}/usuarios
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome": "Padaria Pão Quente",
  "email": "contato@paoquente.com.br",
  "senha": "senhaSegura123",
  "perfil_id": 4
}

### 2.5 Criar conveniado com sucesso (Retorna 201)
# @name novoConveniado
POST {{api}}/conveniados
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "usuario_id": {{usuarioConv.response.body.$.id}},
  "nome_fantasia": "Padaria Pão Quente",
  "razao_social": "Pão Quente Alimentos Ltda",
  "categoria": "Alimentação",
  "cnpj": "99888777000155",
  "endereco": "Rua Barão do Monte Alto, 500, Muriaé"
}

### 2.6 Criar conveniado com CNPJ já em uso (Retorna 409)
POST {{api}}/conveniados
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "usuario_id": 3,
  "nome_fantasia": "Outra Padaria",
  "razao_social": "Outra Padaria Ltda",
  "categoria": "Alimentação",
  "cnpj": "99888777000155",
  "endereco": "Rua Principal, 100"
}

### 2.7 Criar conveniado com CNPJ inválido fora de 14 dígitos (Retorna 400)
POST {{api}}/conveniados
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "usuario_id": 3,
  "nome_fantasia": "Padaria Inválida",
  "razao_social": "Padaria Inválida Ltda",
  "categoria": "Alimentação",
  "cnpj": "123",
  "endereco": "Rua Central, 50"
}

### 2.8 Atualizar dados do conveniado (Retorna 200)
PUT {{api}}/conveniados/{{novoConveniado.response.body.$.id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": "ATIVO"
}

### 2.9 Tentativa de excluir conveniado com benefícios vinculados (Retorna 409)
DELETE {{api}}/conveniados/1
Authorization: Bearer {{token}}

### 2.10 Excluir conveniado sem vínculos (Retorna 204)
DELETE {{api}}/conveniados/{{novoConveniado.response.body.$.id}}
Authorization: Bearer {{token}}
