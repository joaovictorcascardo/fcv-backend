@api = http://localhost:3333/api/v1

###
# @name login
POST {{api}}/auth/login
Content-Type: application/json

{
  "email": "admin@fcv.org.br",
  "senha": "123456"
}

###
@token = {{login.response.body.$.token}}

###
GET {{api}}/colaboradores
Authorization: Bearer {{token}}

###
GET {{api}}/colaboradores/1
Authorization: Bearer {{token}}

###
# @name usuarioColab
POST {{api}}/usuarios
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome": "Helena Prado",
  "email": "helena@fcv.org.br",
  "senha": "123456",
  "perfil_id": 3
}

###
# @name novoColaborador
POST {{api}}/colaboradores
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "usuario_id": {{usuarioColab.response.body.$.id}},
  "matricula": "FCV0100",
  "setor": "Farmácia hospitalar",
  "cargo": "Farmacêutica",
  "data_admissao": "2026-09-01",
  "telefone": "32988887777"
}

###
PUT {{api}}/colaboradores/{{novoColaborador.response.body.$.id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": "AFASTADO"
}

###
DELETE {{api}}/colaboradores/{{novoColaborador.response.body.$.id}}
Authorization: Bearer {{token}}

###
GET {{api}}/conveniados
Authorization: Bearer {{token}}

###
GET {{api}}/conveniados/1
Authorization: Bearer {{token}}

###
# @name usuarioConv
POST {{api}}/usuarios
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome": "Padaria Pão Bom",
  "email": "padaria@parceiro.com",
  "senha": "123456",
  "perfil_id": 4
}

###
# @name novoConveniado
POST {{api}}/conveniados
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "usuario_id": {{usuarioConv.response.body.$.id}},
  "nome_fantasia": "Padaria Pão Bom",
  "razao_social": "Pão Bom Alimentos Ltda",
  "categoria": "Alimentação",
  "cnpj": "44555666000154",
  "endereco": "Rua Barão do Monte Alto, 300, Muriaé"
}

###
PUT {{api}}/conveniados/{{novoConveniado.response.body.$.id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": "ATIVO"
}

###
DELETE {{api}}/conveniados/{{novoConveniado.response.body.$.id}}
Authorization: Bearer {{token}}
