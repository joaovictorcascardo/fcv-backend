@api = http://localhost:3333/api/v1

###
# @name loginColaborador
POST {{api}}/auth/login
Content-Type: application/json

{
  "email": "carla@fcv.org.br",
  "senha": "123456"
}

###
@colaborador = {{loginColaborador.response.body.$.token}}

###
GET {{api}}/eu/utilizacoes
Authorization: Bearer {{colaborador}}

###
GET {{api}}/eu/utilizacoes?status=APROVADA
Authorization: Bearer {{colaborador}}

###
GET {{api}}/eu/utilizacoes?de=2026-10-02&ate=2026-10-02
Authorization: Bearer {{colaborador}}

### Histórico paginado: o total continua restrito ao colaborador autenticado
GET {{api}}/eu/utilizacoes?pagina=1&limite=20&ordenarPor=data_solicitacao&ordem=desc
Authorization: Bearer {{colaborador}}

### 400: data inexistente no calendário
GET {{api}}/eu/utilizacoes?ate=2026-02-30
Authorization: Bearer {{colaborador}}

### 400: período invertido
GET {{api}}/eu/utilizacoes?de=2026-10-26&ate=2026-10-01
Authorization: Bearer {{colaborador}}

### 400: o dono não pode ser substituído por um parâmetro
GET {{api}}/eu/utilizacoes?colaborador_id=2&limite=1
Authorization: Bearer {{colaborador}}

###
GET {{api}}/eu/utilizacoes?status=XX
Authorization: Bearer {{colaborador}}

###
GET {{api}}/eu/utilizacoes?de=02/10/2026
Authorization: Bearer {{colaborador}}

###
# @name loginConveniado
POST {{api}}/auth/login
Content-Type: application/json

{
  "email": "farmacia@parceiro.com",
  "senha": "123456"
}

###
@conveniado = {{loginConveniado.response.body.$.token}}

###
GET {{api}}/eu/utilizacoes
Authorization: Bearer {{conveniado}}

###
# @name loginAdmin
POST {{api}}/auth/login
Content-Type: application/json

{
  "email": "admin@fcv.org.br",
  "senha": "123456"
}

###
@admin = {{loginAdmin.response.body.$.token}}

### Benefício comum: beneficio_id não é o ID de uma oferta
GET {{api}}/utilizacoes?beneficio_id=1&pagina=1&limite=20
Authorization: Bearer {{admin}}

### Item promocional: ID de uma entidade distinta do benefício comum
GET {{api}}/utilizacoes?beneficio_campanha_id=1&pagina=1&limite=20
Authorization: Bearer {{admin}}

###
GET {{api}}/eu/utilizacoes
Authorization: Bearer {{admin}}
